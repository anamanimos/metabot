{
  "manifest_version": 3,
  "name": "Meta Business Suite - IG Story Auto Scheduler",
  "version": "1.0.0",
  "description": "Ekstensi Chrome Manifest V3 untuk otomatisasi penjadwalan Instagram Story di Meta Business Suite dari file JSON.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://business.facebook.com/*",
    "https://web.facebook.com/*",
    "https://*/*",
    "http://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "IG Story Scheduler"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://business.facebook.com/*",
        "https://web.facebook.com/*"
      ],
      "js": ["content_script.js"],
      "run_at": "document_idle"
    }
  ]
}
